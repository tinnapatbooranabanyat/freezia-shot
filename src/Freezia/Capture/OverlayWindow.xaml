<Window x:Class="Freezia.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" UseLayoutRounding="False" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" Title="Freezia Capture"
        FontFamily="{StaticResource UiFont}">
    <Grid x:Name="Root">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />

        <Canvas x:Name="Layer" ClipToBounds="True">
            <Rectangle x:Name="HoverBorder" Stroke="{DynamicResource AccentBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
            <Rectangle x:Name="SelBorder" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                       Visibility="Collapsed" IsHitTestVisible="False" />
            <Canvas x:Name="Handles" IsHitTestVisible="False" />

            <!-- W x H -->
            <Border x:Name="SizeLabel" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="6"
                    Background="#E6202127" Padding="8,3">
                <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Consolas, Segoe UI" />
            </Border>

            <!-- Loupe -->
            <Border x:Name="Loupe" Visibility="Collapsed" IsHitTestVisible="False" Width="136" CornerRadius="10"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Padding="7" Effect="{StaticResource SoftShadow}">
                <StackPanel>
                    <Grid Width="120" Height="120">
                        <Rectangle Fill="#FF101010" RadiusX="6" RadiusY="6" />
                        <Rectangle x:Name="LoupeImage" RadiusX="6" RadiusY="6" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <!-- crosshair row/column -->
                        <Rectangle Fill="#335B8CFF" Height="8" VerticalAlignment="Top" Margin="0,56,0,0" />
                        <Rectangle Fill="#335B8CFF" Width="8" HorizontalAlignment="Left" Margin="56,0,0,0" />
                        <Rectangle Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="55,55,0,0"
                                   Stroke="White" StrokeThickness="1" />
                        <Rectangle Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="56,56,0,0"
                                   Stroke="Black" StrokeThickness="1" />
                        <Rectangle RadiusX="6" RadiusY="6" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" />
                    </Grid>
                    <TextBlock x:Name="LoupePos" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="0,6,0,0"
                               FontFamily="Consolas, Segoe UI" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,3,0,0">
                        <Border x:Name="LoupeSwatch" Width="12" Height="12" CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1"
                                VerticalAlignment="Center" />
                        <TextBlock x:Name="LoupeHex" Foreground="{DynamicResource TextBrush}" FontSize="12" Margin="6,0,0,0"
                                   FontFamily="Consolas, Segoe UI" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Actions after selecting -->
            <Border x:Name="ActionBar" Visibility="Collapsed" CornerRadius="10" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" Effect="{StaticResource CardShadow}"
                    Cursor="Arrow">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnEdit" Style="{StaticResource IconButton}" Content="&#xE70F;" Click="OnEdit" />
                    <Button x:Name="BtnCopy" Style="{StaticResource IconButton}" Content="&#xE8C8;" Click="OnCopy"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Margin="2,0" />
                    <Button x:Name="BtnSave" Style="{StaticResource IconButton}" Content="&#xE74E;" Click="OnSave" />
                    <Button x:Name="BtnSaveAs" Style="{StaticResource IconButton}" Content="&#xE792;" Click="OnSaveAs" />
                    <Border Style="{StaticResource ToolSeparator}" Margin="4,6" />
                    <Button x:Name="BtnPin" Style="{StaticResource IconButton}" Content="&#xE718;" Click="OnPin" />
                    <Button x:Name="BtnOcr" Style="{StaticResource IconButton}" Click="OnOcr">
                        <Path Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              Data="M3,7 V3 H7 M13,3 H17 V7 M17,13 V17 H13 M7,17 H3 V13 M7,7.5 H13 M10,7.5 V13.5" />
                    </Button>
                    <Button x:Name="BtnQr" Style="{StaticResource IconButton}" Content="&#xED14;" Click="OnQr" />
                    <Border Style="{StaticResource ToolSeparator}" Margin="4,6" />
                    <Button x:Name="BtnCancel" Style="{StaticResource IconButton}" Content="&#xE711;" Click="OnCancel" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Top bar -->
        <Border x:Name="TopBar" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,18,0,18"
                CornerRadius="12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" Padding="6" Effect="{StaticResource CardShadow}" Cursor="Arrow">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HintText" Foreground="{DynamicResource TextDimBrush}" FontSize="13" VerticalAlignment="Center" Margin="10,0,12,0" />
                <Button x:Name="BtnFull" Click="OnFullScreen" Padding="10,6" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE740;" />
                        <TextBlock x:Name="FullText" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="4" Padding="5,0">
                            <TextBlock Text="F" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnAll" Click="OnAllScreens" Padding="10,6" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="18" Height="14" Stretch="Uniform" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.4"
                              Data="M1,1 H10 V8 H1 Z M12,3 H21 V10 H12 Z M4,11 H8 M15,13 H19" />
                        <TextBlock x:Name="AllText" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="4" Padding="5,0">
                            <TextBlock Text="A" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnTopCancel" Click="OnCancel" Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE711;" />
                        <TextBlock x:Name="CancelText" Margin="8,0,8,0" VerticalAlignment="Center" />
                        <Border Background="{DynamicResource Surface3Brush}" CornerRadius="4" Padding="5,0">
                            <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource TextDimBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette: every brush key must exist in both Colors.*.xaml files -->
    <SolidColorBrush x:Key="BgBrush" Color="#FFF2F3F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#FFF1F2F6" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#FFE5E7EE" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FFD8DBE3" />
    <SolidColorBrush x:Key="TextBrush" Color="#FF1B1C22" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF676A77" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3D6FEF" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FF5A86F4" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#FF2C5BD6" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#263D6FEF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE5484D" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0F000000" />
    <SolidColorBrush x:Key="PressedBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="SwatchRingBrush" Color="#26000000" />
</ResourceDictionary>

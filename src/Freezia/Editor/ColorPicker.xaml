<UserControl x:Class="Freezia.Editor.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource TextBrush}"
             UseLayoutRounding="True">
    <UserControl.Resources>
        <Style x:Key="ChannelLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="16" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDimBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="NumBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <!-- Slider whose track is a custom gradient (Background) -->
        <Style x:Key="ChannelSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="20" Background="Transparent">
                            <Border Height="8" CornerRadius="4" Background="{StaticResource CheckerBrush}" Margin="7,0" />
                            <Border Height="8" CornerRadius="4" Background="{TemplateBinding Background}" Margin="7,0" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderRepeat}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White" Stroke="#99000000" StrokeThickness="1" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="Card" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Padding="14,14,6,14" Margin="12" Effect="{StaticResource CardShadow}" Width="284">
        <!-- small screens: FitToScreen shrinks the color square, then this scrolls -->
        <ScrollViewer x:Name="CardScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,0,8,0">
            <DockPanel Margin="0,0,0,10">
                <ToggleButton x:Name="EyedropperButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30"
                              Checked="OnEyedropperChecked" Unchecked="OnEyedropperUnchecked">
                    <Path Width="16" Height="16" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M14.5,2.5 C15.6,1.4 17.4,1.4 18.5,2.5 C19.6,3.6 19.6,5.4 18.5,6.5 L16,9 L11,4 Z M12.5,5.5 L4,14 L3,18 L7,17 L15.5,8.5" />
                </ToggleButton>
                <Button x:Name="SaveColorButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="30" Height="30"
                        FontSize="13" Content="&#xE710;" Click="OnSaveColorClick" Margin="0,0,4,0" />
                <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Saturation / Brightness -->
            <Grid x:Name="SvArea" Focusable="True" FocusVisualStyle="{x:Null}" Height="150" Cursor="Cross" ClipToBounds="True"
                  MouseLeftButtonDown="OnSvDown" MouseMove="OnSvMove" MouseLeftButtonUp="OnSvUp">
                <Border x:Name="SvHue" CornerRadius="8" Background="Red" />
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2.5">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- Hue -->
            <Grid x:Name="HueArea" Focusable="True" FocusVisualStyle="{x:Null}" Height="16" Margin="0,12,0,0" Cursor="Hand"
                  MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnHueUp">
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueThumb" Width="8" Height="20" CornerRadius="4" BorderBrush="White" BorderThickness="2" Canvas.Top="-2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <!-- Alpha -->
            <Grid x:Name="AlphaArea" Focusable="True" FocusVisualStyle="{x:Null}" Height="16" Margin="0,10,0,0" Cursor="Hand"
                  MouseLeftButtonDown="OnAlphaDown" MouseMove="OnAlphaMove" MouseLeftButtonUp="OnAlphaUp">
                <Border CornerRadius="8" Background="{StaticResource CheckerBrush}" />
                <Border x:Name="AlphaGradient" CornerRadius="8" />
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="AlphaThumb" Width="8" Height="20" CornerRadius="4" BorderBrush="White" BorderThickness="2" Canvas.Top="-2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                </Canvas>
            </Grid>

            <!-- RGB -->
            <DockPanel Margin="0,14,0,0">
                <TextBlock Text="R" Style="{StaticResource ChannelLabel}" />
                <TextBox x:Name="RBox" DockPanel.Dock="Right" Style="{StaticResource NumBox}" />
                <Slider x:Name="RSlider" Style="{StaticResource ChannelSlider}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="G" Style="{StaticResource ChannelLabel}" />
                <TextBox x:Name="GBox" DockPanel.Dock="Right" Style="{StaticResource NumBox}" />
                <Slider x:Name="GSlider" Style="{StaticResource ChannelSlider}" VerticalAlignment="Center" />
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <TextBlock Text="B" Style="{StaticResource ChannelLabel}" />
                <TextBox x:Name="BBox" DockPanel.Dock="Right" Style="{StaticResource NumBox}" />
                <Slider x:Name="BSlider" Style="{StaticResource ChannelSlider}" VerticalAlignment="Center" />
            </DockPanel>

            <!-- HEX + alpha % -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HEX" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="HexBox" Grid.Column="1" FontFamily="Consolas, Segoe UI" MaxLength="7" CharacterCasing="Upper" />
                <TextBlock x:Name="AlphaLabel" Grid.Column="2" FontSize="12" Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="AlphaBox" Grid.Column="3" Style="{StaticResource NumBox}" Width="54" />
            </Grid>

            <!-- old vs new -->
            <Grid Margin="0,14,0,0" Height="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="8" Background="{StaticResource CheckerBrush}" />
                <Border x:Name="OldSwatch" CornerRadius="8,0,0,8" Cursor="Hand" MouseLeftButtonUp="OnOldClick">
                    <TextBlock x:Name="OldText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                </Border>
                <Border x:Name="NewSwatch" Grid.Column="1" CornerRadius="0,8,8,0">
                    <TextBlock x:Name="NewText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                </Border>
                <Border Grid.ColumnSpan="2" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" IsHitTestVisible="False" />
            </Grid>

            <TextBlock x:Name="EyedropperHint" Visibility="Collapsed" Margin="0,8,0,0" FontSize="11"
                       Foreground="{DynamicResource AccentHoverBrush}" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CancelButton" Click="OnCancelClick" Margin="0,0,8,0" MinWidth="80" />
                <Button x:Name="OkButton" Click="OnOkClick" Style="{StaticResource AccentButton}" MinWidth="80" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

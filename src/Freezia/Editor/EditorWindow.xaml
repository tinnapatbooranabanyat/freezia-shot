<Window x:Class="Freezia.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ed="clr-namespace:Freezia.Editor"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        MinWidth="980" MinHeight="560" Width="1200" Height="800"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Freezia;component/Assets/app.ico">
    <Window.Resources>
        <!-- tool icons: stroke paths bound to the button foreground -->
        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
        </Style>
        <Style x:Key="ToolIconFilled" TargetType="Path" BasedOn="{StaticResource ToolIcon}">
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
        </Style>

        <!-- small round color swatch: no frames, a faint ring only so white/black stay visible -->
        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{StaticResource CheckerBrush}" />
                            <Ellipse Fill="{TemplateBinding Background}" Stroke="{DynamicResource SwatchRingBrush}" StrokeThickness="1" />
                            <Ellipse x:Name="Hover" Margin="-3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "+" (save current color) -->
        <Style x:Key="AddSwatchButton" TargetType="Button" BasedOn="{StaticResource SwatchButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1" StrokeDashArray="2 2" />
                            <Path Data="M4,9 H14 M9,4 V14" Stroke="{DynamicResource TextDimBrush}" StrokeThickness="1.4" Width="9" Height="9" Stretch="Uniform" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Ring" Property="StrokeDashArray" Value="{x:Null}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- stroke / fill target: a clean color dot with a caption; the active one gets a soft accent background -->
        <Style x:Key="TargetButton" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="7,4" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Row 0: tools + actions ===== -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" Padding="10,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIconFilled}" Data="M5,2 L5,17.5 L9,13.6 L11.8,19.5 L14.2,18.4 L11.5,12.6 L17,12.6 Z" />
                    </RadioButton>
                    <Border Style="{StaticResource ToolSeparator}" Margin="6,8" />
                    <RadioButton x:Name="ToolBrush" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIcon}" Data="M3,16 C5,9 8,9 9,12 C10,15 13,15 14,10 C15,6 17,5 18,6" />
                    </RadioButton>
                    <RadioButton x:Name="ToolHighlighter" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIcon}" Data="M12.5,3 L17,7.5 L9,15.5 L5,15.5 L4.5,11 Z M7.5,8 L12,12.5 M3,19 H17" />
                    </RadioButton>
                    <RadioButton x:Name="ToolLine" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIcon}" Data="M4,16 L16,4" />
                    </RadioButton>
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIcon}" Data="M4,16 L16,4 M8.5,4 H16 V11.5" />
                    </RadioButton>
                    <RadioButton x:Name="ToolRect" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIcon}" Data="M3,5 H17 V15 H3 Z" />
                    </RadioButton>
                    <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIcon}" Data="M2.5,10 A7.5,6 0 1 0 17.5,10 A7.5,6 0 1 0 2.5,10 Z" />
                    </RadioButton>
                    <RadioButton x:Name="ToolText" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIcon}" Data="M4,6 V3.5 H16 V6 M10,3.5 V16.5 M7,16.5 H13" />
                    </RadioButton>
                    <RadioButton x:Name="ToolMosaic" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Path Style="{StaticResource ToolIconFilled}"
                              Data="M3,3 H7.5 V7.5 H3 Z M12.5,3 H17 V7.5 H12.5 Z M7.5,7.5 H12.5 V12.5 H7.5 Z M3,12.5 H7.5 V17 H3 Z M12.5,12.5 H17 V17 H12.5 Z" />
                    </RadioButton>
                    <RadioButton x:Name="ToolStep" Style="{StaticResource ToolButton}" GroupName="tools">
                        <Grid Width="20" Height="20">
                            <Ellipse Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" StrokeThickness="1.7" />
                            <TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
                        </Grid>
                    </RadioButton>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;" Click="OnUndo" />
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;" Click="OnRedo" />
                    <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;" Click="OnDelete" />
                    <Border Style="{StaticResource ToolSeparator}" Margin="8,8" />
                    <Button x:Name="CopyButton" Click="OnCopy" Padding="12,7" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE8C8;" />
                            <TextBlock x:Name="CopyText" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveAsButton" Click="OnSaveAs" Padding="12,7" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE792;" />
                            <TextBlock x:Name="SaveAsText" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource AccentButton}" Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE74E;" Foreground="White" />
                            <TextBlock x:Name="SaveText" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Row 1: style properties ===== -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,1" Padding="10,6">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <!-- stroke -->
                    <ToggleButton x:Name="StrokeTarget" Style="{StaticResource TargetButton}" Click="OnStrokeTargetClick">
                        <StackPanel>
                            <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                <Ellipse Fill="{StaticResource CheckerBrush}" />
                                <Ellipse x:Name="StrokeSwatch" Stroke="{DynamicResource SwatchRingBrush}" StrokeThickness="1" />
                            </Grid>
                            <TextBlock x:Name="StrokeCaption" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextDimBrush}" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- fill -->
                    <ToggleButton x:Name="FillTarget" Style="{StaticResource TargetButton}" Click="OnFillTargetClick" Margin="2,0,0,0">
                        <StackPanel>
                            <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                <Ellipse Fill="{StaticResource CheckerBrush}" />
                                <Ellipse x:Name="FillSwatch" Stroke="{DynamicResource SwatchRingBrush}" StrokeThickness="1" />
                                <Path x:Name="FillOffSlash" Data="M3.5,20.5 L20.5,3.5" Stroke="{DynamicResource DangerBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Grid>
                            <TextBlock x:Name="FillCaption" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextDimBrush}" />
                        </StackPanel>
                    </ToggleButton>
                    <CheckBox x:Name="FillToggle" Style="{StaticResource ToggleSwitch}" Margin="8,0,0,0" VerticalAlignment="Center"
                              Click="OnFillToggle" />

                    <Border Style="{StaticResource ToolSeparator}" Margin="12,6" />
                    <WrapPanel x:Name="PresetPanel" Width="96" VerticalAlignment="Center" />

                    <Border Style="{StaticResource ToolSeparator}" Margin="10,6" />
                    <WrapPanel x:Name="SavedPanel" MaxWidth="144" VerticalAlignment="Center" />

                    <Border x:Name="RecentSeparator" Style="{StaticResource ToolSeparator}" Margin="10,6" />
                    <WrapPanel x:Name="RecentPanel" MaxWidth="96" VerticalAlignment="Center" />

                    <Border Style="{StaticResource ToolSeparator}" Margin="12,6" />

                    <TextBlock x:Name="SizeLabel" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" FontSize="12" />
                    <Slider x:Name="SizeSlider" Width="130" VerticalAlignment="Center" Margin="10,0,6,0"
                            Minimum="1" Maximum="30" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" />
                    <TextBlock x:Name="SizeValue" VerticalAlignment="Center" Width="30" FontSize="12" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ===== Row 2: canvas ===== -->
        <ScrollViewer x:Name="Scroller" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Focusable="False" Background="{DynamicResource BgBrush}">
            <Grid x:Name="Pad" Margin="28">
                <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                    <Grid.LayoutTransform>
                        <ScaleTransform x:Name="ZoomTransform" />
                    </Grid.LayoutTransform>
                    <Grid x:Name="ExportRoot" ClipToBounds="True" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="BaseImage" Stretch="None" />
                        <Canvas x:Name="DrawCanvas" />
                        <Canvas x:Name="TextLayer" />
                    </Grid>
                    <Canvas x:Name="AdornerLayer" IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </ScrollViewer>

        <Popup x:Name="PickerPopup" Grid.Row="1" StaysOpen="True" AllowsTransparency="True" Placement="Bottom"
               PopupAnimation="Fade" HorizontalOffset="-12" VerticalOffset="-6">
            <ed:ColorPicker x:Name="Picker" />
        </Popup>

        <!-- ===== Row 3: status bar ===== -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,3">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ImageInfo" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock x:Name="CursorInfo" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Margin="20,0,0,0"
                           Foreground="{DynamicResource TextDimBrush}" FontFamily="Consolas, Segoe UI" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ZoomOutButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE71F;" Click="OnZoomOut" />
                    <TextBlock x:Name="ZoomText" Width="52" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE8A3;" Click="OnZoomIn" />
                    <Button x:Name="FitButton" Style="{StaticResource IconButton}" Width="30" Height="30" FontSize="13" Content="&#xE9A6;" Click="OnZoomFit" />
                    <Button x:Name="ActualButton" Style="{StaticResource IconButton}" Width="40" Height="30" FontSize="12"
                            FontFamily="{StaticResource UiFont}" FontWeight="SemiBold" Content="1:1" Click="OnZoom100" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

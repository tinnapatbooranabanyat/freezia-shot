<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Windows 10 1809+: same floor as the installer (MinVersion 10.0.17763) -->
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WPF app: DPI awareness must come from app.manifest, not the WinForms API -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <RootNamespace>Freezia</RootNamespace>
    <AssemblyName>Freezia</AssemblyName>
    <Product>Freezia</Product>
    <Company>Freezia</Company>
    <Description>Freezia - Screenshot and annotation tool</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- No telemetry / network: nothing in this app talks to the internet. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Tesseract + Leptonica native DLLs embedded into the exe (extracted on first OCR) -->
    <OcrNativeDir Condition="'$(OcrNativeDir)' == ''">$(PkgTesseractOCR)\x64</OcrNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- IBM Plex Sans Thai (SIL Open Font License 1.1, see Assets/Fonts/OFL.txt), embedded: nothing to install -->
    <Resource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <ItemGroup>
    <!-- QR / barcodes (Apache-2.0) -->
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <!-- Thai + English OCR (Apache-2.0). Its build targets would copy native DLLs next to the exe and
         break the single-file build, so they are excluded and the natives are embedded below instead. -->
    <PackageReference Include="TesseractOCR" Version="5.5.2" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- extracted to %LocalAppData%\Freezia\ocr\<version>\ on first OCR (see Core/OcrService.cs) -->
    <!-- OcrNativeDir: CI passes the folder with the code-signed copies (see .github/workflows/release.yml) -->
    <EmbeddedResource Include="$(OcrNativeDir)\*.dll" LogicalName="ocr/x64/%(Filename)%(Extension)" Visible="false" />
    <EmbeddedResource Include="Assets\Ocr\tessdata\*.traineddata" LogicalName="ocr/tessdata/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>

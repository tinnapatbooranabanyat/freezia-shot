<Window x:Class="Freezia.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Freezia.UI"
        xmlns:ed="clr-namespace:Freezia.Editor"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Width="860" Height="820" MinWidth="620" MinHeight="520"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Icon="pack://application:,,,/Freezia;component/Assets/app.ico">
    <Window.Resources>
        <!-- round accent swatch: the selected one gets a ring in the text color -->
        <!-- theme preview card -->
        <Style x:Key="ThemeCard" TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Ring" CornerRadius="11" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" Visibility="Hidden" />
                            <Ellipse x:Name="Dot" Margin="5" Fill="{TemplateBinding Background}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,12">
                <!-- header -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Image Source="pack://application:,,,/Freezia;component/Assets/app.ico" Width="36" Height="36"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTitle" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="AboutText" Style="{StaticResource DimText}" />
                    </StackPanel>
                </StackPanel>

                <!-- Appearance -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LblLanguage" Style="{StaticResource RowLabel}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="LangTh" Style="{StaticResource PillRadio}" GroupName="lang" Content="ไทย" Checked="OnLanguagePicked" />
                                <RadioButton x:Name="LangEn" Style="{StaticResource PillRadio}" GroupName="lang" Content="English" Checked="OnLanguagePicked" />
                            </StackPanel>
                            <TextBlock x:Name="LblTheme" Grid.Row="1" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <WrapPanel x:Name="ThemePanel" />
                                <TextBlock x:Name="ThemeHint" Style="{StaticResource DimText}" Margin="0,0,0,4" />
                            </StackPanel>
                            <TextBlock x:Name="LblAccent" Grid.Row="2" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,18,0,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,12,0,0">
                                <WrapPanel x:Name="AccentPanel" />
                                <TextBlock x:Name="AccentHint" Style="{StaticResource DimText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Hotkeys -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="HotkeysHeader" Style="{StaticResource SectionHeader}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="LblRegion" Style="{StaticResource RowLabel}" />
                            <ui:HotkeyBox x:Name="BoxRegion" Grid.Column="1" Margin="0,4" />
                            <TextBlock x:Name="LblScreen" Grid.Row="1" Style="{StaticResource RowLabel}" />
                            <ui:HotkeyBox x:Name="BoxScreen" Grid.Row="1" Grid.Column="1" Margin="0,4" />
                            <TextBlock x:Name="LblAll" Grid.Row="2" Style="{StaticResource RowLabel}" />
                            <ui:HotkeyBox x:Name="BoxAll" Grid.Row="2" Grid.Column="1" Margin="0,4" />
                            <TextBlock x:Name="LblColor" Grid.Row="3" Style="{StaticResource RowLabel}" />
                            <ui:HotkeyBox x:Name="BoxColor" Grid.Row="3" Grid.Column="1" Margin="0,4" />
                        </Grid>
                        <Border x:Name="HotkeyError" Visibility="Collapsed" Margin="0,10,0,0" CornerRadius="8" Padding="10,7"
                                Background="#26FF5C5C" BorderBrush="#66FF5C5C" BorderThickness="1">
                            <TextBlock x:Name="HotkeyErrorText" Foreground="#FFFF8A8A" TextWrapping="Wrap" FontSize="12" />
                        </Border>
                        <TextBlock x:Name="HotkeyHelp" Style="{StaticResource DimText}" Margin="0,10,0,0" />
                        <TextBlock x:Name="SnippingNote" Style="{StaticResource DimText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <!-- Saving -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="SaveHeader" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="LblFolder" Style="{StaticResource RowLabel}" Margin="0,0,0,6" />
                        <DockPanel>
                            <Button x:Name="ResetFolderButton" DockPanel.Dock="Right" Margin="6,0,0,0" Click="OnResetFolder" />
                            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Margin="8,0,0,0" Click="OnBrowse" />
                            <TextBox x:Name="FolderBox" IsReadOnly="True" Padding="10,7" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <TextBlock x:Name="FolderHint" Style="{StaticResource DimText}" Margin="0,6,0,0" />

                        <TextBlock x:Name="LblFormat" Style="{StaticResource RowLabel}" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="FmtPng" Style="{StaticResource PillRadio}" GroupName="fmt" Content="PNG" Checked="OnFormatChanged" />
                            <RadioButton x:Name="FmtJpg" Style="{StaticResource PillRadio}" GroupName="fmt" Content="JPG" Checked="OnFormatChanged" />
                        </StackPanel>
                        <DockPanel x:Name="JpegPanel" Margin="0,12,0,0">
                            <TextBlock x:Name="LblQuality" Style="{StaticResource RowLabel}" Width="90" />
                            <TextBlock x:Name="QualityValue" DockPanel.Dock="Right" Width="36" VerticalAlignment="Center" TextAlignment="Right" />
                            <Slider x:Name="QualitySlider" Minimum="50" Maximum="100" SmallChange="1" LargeChange="5"
                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" Margin="8,0" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- After full capture -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock x:Name="AfterHeader" Style="{StaticResource SectionHeader}" />
                        <WrapPanel>
                            <RadioButton x:Name="AfterEditor" Style="{StaticResource PillRadio}" GroupName="after" Margin="0,0,6,6" />
                            <RadioButton x:Name="AfterCopy" Style="{StaticResource PillRadio}" GroupName="after" Margin="0,0,6,6" />
                            <RadioButton x:Name="AfterSave" Style="{StaticResource PillRadio}" GroupName="after" Margin="0,0,6,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- General -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="GeneralHeader" Style="{StaticResource SectionHeader}" />
                        <CheckBox x:Name="StartupToggle" Style="{StaticResource ToggleSwitch}" />
                        <TextBlock x:Name="LblCaptureMethod" Style="{StaticResource RowLabel}" Margin="0,16,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="MethodAuto" Style="{StaticResource PillRadio}" GroupName="method" />
                            <RadioButton x:Name="MethodGdi" Style="{StaticResource PillRadio}" GroupName="method" />
                        </StackPanel>
                        <TextBlock x:Name="CaptureMethodHint" Style="{StaticResource DimText}" Margin="0,6,0,0" />
                        <CheckBox x:Name="HistoryToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" />
                        <DockPanel x:Name="HistoryPanel" Margin="50,10,0,0">
                            <TextBlock x:Name="LblHistoryLimit" Style="{StaticResource RowLabel}" Width="150" />
                            <TextBlock x:Name="HistoryLimitValue" DockPanel.Dock="Right" Width="40" VerticalAlignment="Center" TextAlignment="Right" />
                            <Slider x:Name="HistoryLimitSlider" Minimum="10" Maximum="200" SmallChange="10" LargeChange="10"
                                    IsSnapToTickEnabled="True" TickFrequency="10" VerticalAlignment="Center" Margin="8,0" />
                        </DockPanel>
                        <TextBlock x:Name="HistoryHint" Style="{StaticResource DimText}" Margin="50,6,0,0" />
                        <CheckBox x:Name="UpdateToggle" Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0" />
                        <TextBlock x:Name="UpdateHint" Style="{StaticResource DimText}" Margin="50,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="50,10,0,0">
                            <Button x:Name="CheckUpdateButton" MinWidth="150" Click="OnCheckUpdates" />
                            <TextBlock x:Name="UpdateStatus" Style="{StaticResource DimText}" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Popup x:Name="AccentPopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade"
               HorizontalOffset="-12" VerticalOffset="-6">
            <ed:ColorPicker x:Name="AccentPicker" />
        </Popup>

        <!-- footer -->
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="96" Margin="0,0,8,0" Click="OnCancel" IsCancel="True" />
                <Button x:Name="OkButton" MinWidth="110" Style="{StaticResource AccentButton}" Click="OnOk" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
